# VAPID private key (base64url, raw P-256 scalar — ~43 chars).
# Generate one with any web-push tool; keep the matching public key
# in your client as `applicationServerKey`.
VAPID_PRIVATE_KEY=

# Contact URI for the VAPID JWT `sub` claim (RFC 8292).
# Must be a mailto: or https: URI. Apple Web Push enforces this.
VAPID_SUBJECT=mailto:you@example.com

# HTTP listen port.
PORT=8080
