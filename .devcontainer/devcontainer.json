{
  "name": "web-push-testing-server",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "web-push-testing-server",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "cargo build",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ]
    }
  }
}
